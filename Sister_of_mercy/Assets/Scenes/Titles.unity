  m_Text: "\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0438:\r\n\u0413\u0435\u0440\u0430\u0441\u0438\u043C\u043E\u0432
    \u041C\u0430\u0442\u0432\u0435\u0439 - \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\r\n\u0411\u043E\u0439\u043A\u043E
